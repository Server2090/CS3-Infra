# ── Ansible ───────────────────────────────────────────────────────
# Retry files created on failed playbook runs — not useful in git
ansible/*.retry
ansible/**/*.retry

# Decrypted secret files — always keep encrypted versions only
ansible/inventory/group_vars/*.sops.yml
ansible/inventory/group_vars/*.sops.yaml

# ── OpenTofu ──────────────────────────────────────────────────────
# State files contain plaintext secrets and live infra details
tofu/*.tfstate
tofu/*.tfstate.*
tofu/*.tfstate.backup

# Downloaded provider binaries and cached modules — regenerated by tofu init
tofu/.terraform/

# Lock file — regenerated by tofu init
tofu/.terraform.lock.hcl

# Saved plan files — contain sensitive data
tofu/*.tfplan

# Decrypted secrets
tofu/*.decrypted.*
tofu/secrets.sops.yaml
tofu/secrets.sops.yml

# ── SOPS ──────────────────────────────────────────────────────────
# Never commit any sops secret files
*.sops.yaml
*.sops.yml

# ── Age ───────────────────────────────────────────────────────────
# Private keys — never leave this machine
*.age
keys.txt

# ── General ───────────────────────────────────────────────────────
# Editor temp files
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
