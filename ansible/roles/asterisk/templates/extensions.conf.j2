; {{ ansible_managed }}
; ansible/roles/asterisk/templates/extensions.conf.j2
; Asterisk dialplan — defines what happens when a phone dials a number.
;
; Structure:
;   [internal]  — context for all internal extensions
;   Each extension has a priority chain: 1, 2, 3...
;   Asterisk executes priorities in order when that number is dialed.

[general]
; General dialplan settings.
static = yes
; static = yes means the dialplan is loaded from this file, not
; a database. Required for file-based configuration.

writeprotect = no
; writeprotect = no allows the dialplan to be reloaded at runtime
; with: asterisk -rx "dialplan reload"
; Set to yes only if you want to prevent runtime changes.

[{{ dialplan_context }}]
; All extensions are in the [internal] context.
; Phones assigned context=internal in pjsip.conf can ONLY reach
; numbers defined in this context. This is your security boundary —
; there are no rules here for outside lines, so outside calls are
; simply impossible from these phones.

; ── Extension dialing ──────────────────────────────────────────────────────
; Generated by Jinja2 loop over sip_extensions in vars/main.yml.
; To add a new extension: add it to sip_extensions — this template
; regenerates automatically on the next playbook run.

{% for ext in sip_extensions %}
; {{ ext.label }}
exten = {{ ext.id }},1,NoOp(Call to {{ ext.label }})
; exten = <number>,<priority>,<application>
; NoOp = No Operation — does nothing but log the call attempt.
; Useful for seeing call flow in the Asterisk log:
;   asterisk -rx "core show channels"

exten = {{ ext.id }},2,Dial(PJSIP/{{ ext.id }},30)
; Dial(PJSIP/{{ ext.id }},30) — ring extension {{ ext.id }} for 30 seconds.
; PJSIP/ = use the PJSIP channel driver (chan_pjsip).
; {{ ext.id }} = the endpoint name from pjsip.conf.
; 30 = ring timeout in seconds. If not answered in 30s, move to next priority.

exten = {{ ext.id }},3,Voicemail({{ ext.id }}@default,u)
; If not answered, send to voicemail box {{ ext.id }} in the default context.
; u = play the "unavailable" voicemail greeting.
; Voicemail requires voicemail.conf to be configured — this line
; is here as a placeholder. If voicemail is not configured, Asterisk
; plays a "mailbox does not exist" message and hangs up gracefully.

exten = {{ ext.id }},4,Hangup()
; Hang up after voicemail. Belt and suspenders — Voicemail normally
; handles the hangup itself, but explicit Hangup() prevents the call
; from falling through to unexpected behaviour.

{% endfor %}

; ── Invalid extension handling ─────────────────────────────────────────────

exten = i,1,NoOp(Invalid extension dialed)
exten = i,2,Playback(invalid)
; i = the "invalid" extension — Asterisk jumps here when a dialed
; number does not match any defined extension.
; Playback(invalid) plays the built-in "that extension is not valid"
; audio prompt so the caller knows they dialed wrong.

exten = i,3,Hangup()

exten = t,1,NoOp(Call timed out waiting for input)
exten = t,2,Hangup()
; t = the "timeout" extension — Asterisk jumps here when a caller
; does not dial anything within the digit timeout period.
; Hangs up cleanly rather than leaving the call in limbo.
