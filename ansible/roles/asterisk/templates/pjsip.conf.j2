; {{ ansible_managed }}
; ansible/roles/asterisk/templates/pjsip.conf.j2
; Asterisk PJSIP configuration — SIP transport, endpoints, and auth.
; Semicolons are comments in Asterisk config files.
;
; Structure of this file (order matters — Asterisk reads top to bottom):
;   1. Transport    — how SIP packets arrive (UDP, which IP, which port)
;   2. For each extension:
;      a. endpoint  — the SIP device definition
;      b. auth      — the username/password for registration
;      c. aor       — Address of Record: where to send calls for this extension
;      d. identify  — match inbound packets to this endpoint by source IP

; ── Transport ──────────────────────────────────────────────────────────────

[{{ pjsip_transport }}]
type = transport
protocol = udp
; UDP is the standard SIP transport for internal networks.
; Lower overhead than TCP, works reliably on LANs.
; Both HT802 ATAs default to UDP — no device config change needed.

bind = {{ pjsip_bind_ip }}:{{ sip_port }}
; Listen on all interfaces on port 5060.
; UFW restricts who can reach this port — see firewall.yml.

{% for net in pjsip_local_nets %}
local_net = {{ net }}
{% endfor %}
; local_net tells PJSIP which subnets are directly reachable.
; For each subnet listed, PJSIP trusts the Contact header IP
; the device sends and does not rewrite it.
; Without this, PJSIP thinks devices are behind NAT and rewrites
; their Contact headers — breaking audio (one-way or no audio).
; Jinja2 for loop generates one local_net line per subnet in
; pjsip_local_nets from vars/main.yml.

; ── Extensions ─────────────────────────────────────────────────────────────
; One block of four sections per extension.
; Generated by Jinja2 loop over sip_extensions in vars/main.yml.
; To add a new extension: add an entry to sip_extensions — no other
; file needs changing.

{% for ext in sip_extensions %}
; ── {{ ext.label }} (extension {{ ext.id }}) ──────────────────────────────

[{{ ext.id }}]
type = endpoint
; endpoint = a SIP device definition. This is what Asterisk calls
; the logical representation of a phone or ATA port.

transport = {{ pjsip_transport }}
; Which transport this endpoint uses — matches the transport defined above.

context = {{ dialplan_context }}
; Which dialplan context handles calls from this endpoint.
; "internal" means this phone can only reach other internal extensions.
; It cannot accidentally dial outside lines or system contexts.

disallow = all
; Reject all audio codecs first, then allow only the ones we want.
; "disallow all" before "allow" is required — without it Asterisk
; uses a compiled-in default codec list that includes old/insecure codecs.

allow = ulaw
; G.711 mu-law — the standard North American telephony codec.
; Uncompressed, no latency, excellent quality on a LAN.
; All Grandstream HT802 ATAs support ulaw natively.

allow = alaw
; G.711 a-law — the standard European telephony codec.
; Same quality as ulaw, different encoding curve.
; Including both ensures compatibility regardless of ATA region setting.

allow = opus
; Opus — modern wideband codec, excellent quality, low bandwidth.
; Better than G.711 for HD voice if both endpoints support it.
; Listed last so G.711 is preferred for ATA compatibility.

auth = auth{{ ext.id }}
; References the [auth{{ ext.id }}] block below.
; Asterisk uses this block to verify the ATA's SIP registration.

aors = {{ ext.id }}
; References the [{{ ext.id }}] AoR block below.
; AoR (Address of Record) is where Asterisk sends inbound calls
; destined for this extension.

[auth{{ ext.id }}]
type = auth
auth_type = userpass
; userpass = username and password authentication.
; The ATA sends these credentials when registering.

username = {{ ext.id }}
; SIP username — matches the extension number.
; This is what you enter in the ATA's "SIP User ID" field.

password = {{ vars[ext.secret_var] }}
; SIP password — decrypted from voip.sops.yml at playbook runtime.
; vars[ext.secret_var] looks up the variable named in secret_var.
; For extension 101: vars["sip_secret_101"] = the decrypted password.
; This value never appears in git — only in the encrypted sops file
; and in the rendered file on the VM (owned by asterisk:asterisk, mode 0640).

[{{ ext.id }}]
; AoR section — same name as endpoint, different type
type = aor
; AoR (Address of Record) — tracks where a registered device is located.
; When the HT802 registers, Asterisk stores its contact address here.
; When a call arrives for this extension, Asterisk looks here to find
; the current IP and port of the device to send the call to.

max_contacts = 1
; Only one device can be registered per extension at a time.
; If a second device tries to register with the same credentials,
; it replaces the first registration. Prevents split-brain where
; two devices share one extension and calls go to the wrong one.

remove_existing = true
; When a new registration arrives, remove the old one first.
; Works with max_contacts=1 to ensure clean re-registration
; when an ATA reboots or its IP address changes.

[identify{{ ext.id }}]
type = identify
; identify blocks match inbound SIP packets to an endpoint by
; source IP address, before authentication happens.
; This is an additional security layer — packets from unexpected
; IPs are rejected before even reaching the auth stage.

endpoint = {{ ext.id }}
; Which endpoint this identify block is associated with.

match = {{ ext.ata_host }}
; Only accept SIP packets from this specific IP address for
; this endpoint. Packets from any other IP claiming to be
; extension {{ ext.id }} are dropped silently.
; Both ports on an HT802 come from the same IP so both
; extensions on one ATA share the same match IP.

{% endfor %}
